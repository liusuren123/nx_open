<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <Fragment Id='FragmentClientPackage'>
        <PackageGroup Id="ClientPackageGroup">
            <MsiPackage
                Id="ClientPackage"
                Name="client"
                SourceFile="${client_msi_filename}"
                InstallCondition="InstallClientOnly=1 OR InstallClientAndServer=1"
                Vital="yes"
                Compressed="yes">
                <!-- The folder picked on the options page overrides the MSI's default INSTALLDIR. -->
                <MsiProperty Name="INSTALLDIR" Value="[InstallFolder]" />
            </MsiPackage>

            <!-- WiX generates a random registration id for every bundle, so rebuilding and
                 reinstalling the same version leaves an extra "Apps & Features" entry behind,
                 whose uninstall removes the shared client MSI (application, shortcuts and client
                 settings). Runs on every install and drops the registrations of all other builds
                 of this product; the one that is being installed is passed in and preserved. -->
            <ExePackage
                Id="CleanStaleClientBundles"
                SourceFile="${bin_source_dir}/nx_wix_bundle_cleanup.exe"
                InstallCommand='--display-name "${customization.vmsName} Client" --keep-provider-key "[WixBundleProviderKey]"'
                UninstallCommand="--noop"
                DetectCondition="0"
                Permanent="yes"
                Vital="no"
                Protocol="none"
                Compressed="yes">
            </ExePackage>
        </PackageGroup>
    </Fragment>
</Wix>
